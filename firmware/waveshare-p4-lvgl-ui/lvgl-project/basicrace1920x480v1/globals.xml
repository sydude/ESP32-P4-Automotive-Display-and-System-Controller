	<fonts>
		<!-- Add <bin> , <tiny_ttf>, <freetype> tags here -->
		<!-- FontAwesome glyphs for the LV_SYMBOLs used by lv_keyboard (left,
		     right, OK, close, backspace, new-line, keyboard) plus up/down.
		     lv_fallback=font_body so Latin keys still render from one font. -->

		<bin
			name="font_default"
			src_path="fonts/Montserrat-Regular.ttf"
			size="20"
			bpp="4"
			range="0x20-0x7E"
			symbols="°—•±×µΩ"
			as_file="false"
		/>
		<bin
			name="font_bold_20"
			src_path="fonts/Montserrat-Bold.ttf"
			size="20"
			bpp="4"
			as_file="false"
		/>
		<bin
			name="font_bold_36"
			src_path="fonts/Montserrat-Bold.ttf"
			size="36"
			bpp="4"
			as_file="false"
		/>
		<bin
			name="font_body_symbols"
			size="16"
			src_path="fonts/FontAwesome5.ttf"
			bpp="4"
			range="0xF00C,0xF00D,0xF053-0xF054,0xF077-0xF078,0xF11C,0xF55A,0xF8A2"
			as_file="false"
		/>
		<bin
			name="font_body"
			size="16"
			src_path="fonts/Montserrat-Regular.ttf"
			bpp="4"
			range="0x20-0x7E"
			symbols="°—•±×µΩ"
			as_file="false"
			lv_fallback="font_body_symbols_data"
		/>
		<bin
			name="font_dash_category_18"
			size="18"
			src_path="fonts/EurostileLT-BoldExtendedTwo.ttf"
			bpp="4"
			range="0x20-0x7E"
			symbols="°—•±×µΩ"
			as_file="false"
		/>
		<bin
			name="font_dash_category_14"
			size="14"
			src_path="fonts/EurostileLT-BoldExtendedTwo.ttf"
			bpp="4"
			range="0x20-0x7E"
			symbols="°—•±×µΩ"
			as_file="false"
		/>
		<bin
			name="font_dash_item_14"
			size="14"
			src_path="fonts/EurostileLT-Demi.ttf"
			bpp="4"
			range="0x20-0x7E"
			symbols="°—•±×µΩ"
			as_file="false"
		/>
		<!--
		for automotive fonts use:
			symbols="°—•±×µΩ"
				and 
			range="0x20-0x7E"
		-->
	</fonts>

