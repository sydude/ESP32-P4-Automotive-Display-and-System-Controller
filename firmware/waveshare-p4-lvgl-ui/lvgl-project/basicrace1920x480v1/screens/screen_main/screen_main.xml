			<lv_image
				name="dashboard_notch_overlay"
				src="notch"
				align="top_mid"
			/>
			<lv_image
				name="dashboard_logo_overlay"
				src="screen_1_logo"
				align="center"
			/>
		</lv_obj>
		<lv_obj
			name="vehicle_graphics"
			align="top_left"
			x="0"
			y="0"
			height="480"
			width="500"
			scrollable="false"
			clickable="false"
			style_bg_opa="0"
			style_border_width="0"
			style_pad_all="0"
		>
			<lv_image
				name="raptor_front_widget"
				src="raptor_front"
				x="40"
				y="20"
				clickable="false"
			/>
			<lv_image
				name="raptor_rear_widget"
				src="raptor_rear"
				x="40"
				y="220"
				clickable="false"
			/>
			<lv_image
				name="rear_lights_overlay"
				src="rear_lights"
				x="-40"
				y="287"
				clickable="false"
				hidden="{rear_lights_on == 0}"
			/>
			<lv_image
				name="wide_lights_overlay"
				src="wide_lights"
				x="21"
				y="124"
				clickable="false"
				hidden="{wide_lights_on == 0}"
			/>
			<lv_image
				name="amber_lights_overlay"
				src="amber_lights"
				x="38"
				y="123"
				clickable="false"
				hidden="{amber_lights_on == 0}"
			/>
		</lv_obj>

