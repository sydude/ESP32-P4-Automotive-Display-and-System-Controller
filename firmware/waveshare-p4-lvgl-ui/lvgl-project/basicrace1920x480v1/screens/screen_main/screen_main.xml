<screen>
	<view extends="lv_obj" scrollable="false">
		<!-- <style name="style_screen_1_bg" /> -->
		<lv_image
			name="screen_1_bg_widget"
			src="screen_1_bg"
			align="top_mid"
			x="0"
			y="0"
			clickable="false"
