		<lv_obj
			name="svt_aux_switches"
			align="bottom_right"
			x="-30"
			y="-70"
			width="308"
			height="176"
			style_pad_all="0"
			style_bg_opa="0%"
			style_border_width="0"
			scrollable="false"
			clickable="false"
		>
			<lv_image
				name="svt_switch_base"
				src="svt_switches"
				x="0"
				y="0"
				width="308"
				height="176"
				scrollable="false"
				clickable="false"
			/>
			<lv_imagebutton
				name="svt_switch_1"
				x="29"
				y="36"
				width="64"
				height="94"
				checkable="true"
				bind_checked="amber_lights_on"
				style_bg_opa="0%"
				style_border_width="0"
				style_pad_all="0"
			>
				<lv_imagebutton-src state="released" mid="svt_switch_1_off" />
				<lv_imagebutton-src state="pressed" mid="svt_switch_1_off" />
				<lv_imagebutton-src
					state="checked_released"
					mid="svt_switch_1_on"
				/>
				<lv_imagebutton-src
					state="checked_pressed"
					mid="svt_switch_1_on"
				/>
			</lv_imagebutton>
			<lv_imagebutton
				name="svt_switch_2"
				x="91"
				y="36"
				width="62"
				height="94"
				checkable="true"
				bind_checked="wide_lights_on"
				style_bg_opa="0%"
				style_border_width="0"
				style_pad_all="0"
			>
				<lv_imagebutton-src state="released" mid="svt_switch_2_off" />
				<lv_imagebutton-src state="pressed" mid="svt_switch_2_off" />
				<lv_imagebutton-src
					state="checked_released"
					mid="svt_switch_2_on"
				/>
				<lv_imagebutton-src
					state="checked_pressed"
					mid="svt_switch_2_on"
				/>
			</lv_imagebutton>
			<lv_imagebutton
				name="svt_switch_3"
				x="154"
				y="36"
				width="62"
				height="94"
				checkable="true"
				bind_checked="rear_lights_on"
				style_bg_opa="0%"
				style_border_width="0"
				style_pad_all="0"
			>
				<lv_imagebutton-src state="released" mid="svt_switch_3_off" />
				<lv_imagebutton-src state="pressed" mid="svt_switch_3_off" />
				<lv_imagebutton-src
					state="checked_released"
					mid="svt_switch_3_on"
				/>
				<lv_imagebutton-src
					state="checked_pressed"
					mid="svt_switch_3_on"
				/>
			</lv_imagebutton>
			<lv_imagebutton
				name="svt_switch_4"
				x="216"
				y="36"
				width="64"
				height="94"
				checkable="true"
				bind_checked="seat_eject_true"
				style_bg_opa="0%"
				style_border_width="0"
				style_pad_all="0"
			>
				<lv_imagebutton-src state="released" mid="svt_switch_4_off" />
				<lv_imagebutton-src state="pressed" mid="svt_switch_4_off" />
				<lv_imagebutton-src
					state="checked_released"
					mid="svt_switch_4_on"
				/>
				<lv_imagebutton-src
					state="checked_pressed"
					mid="svt_switch_4_on"
				/>
			</lv_imagebutton>
		</lv_obj>
		<lv_obj
			name="gauges"
			height="100%"
			style_bg_opa="0%"
			style_border_width="0"
			style_pad_all="0"
			scrollable="false"
			clickable="false"
			x="0"
			y="2"
			width="100"
		/>

		<lv_obj
			name="brightness_container"
			width="240"
			height="30"
			align="bottom_right"
			x="-30"
			y="-20"
			scrollable="false"
			style_bg_opa="0%"
			style_border_width="0"
			style_pad_all="0"
		>
			<lv_slider
				name="brightness_slider"
				width="240"
				height="24"
				align="center"
				min_value="10"
				max_value="100"
				bind_value="subject_brightness"
			/>

			<lv_label
				name="brightness_percent"
				bind_text="subject_brightness"
				bind_text-fmt="%d%%"
				align="left_mid"
				style_text_font="font_bold_20"
				style_text_color="0x4c4c4c"
				x="12"
			/>
			<lv_label
				name="brightness_status"
				text="10-100% | Drag to adjust"
				hidden="true"
			/>
		</lv_obj>
	</view>
</screen>
